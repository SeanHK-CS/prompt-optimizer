# Everything works with NO keys at all: the free rules engine runs in the browser
# and prompts.chat search needs no auth. Keys below only unlock optional engines.

# Which rewrite engine the Optimize button uses: rules (default) | claude | prompts-chat
NEXT_PUBLIC_OPTIMIZE_ENGINE=rules

# Only if NEXT_PUBLIC_OPTIMIZE_ENGINE=claude. Server-side only; costs you per call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only if NEXT_PUBLIC_OPTIMIZE_ENGINE=prompts-chat (free; generate at prompts.chat/settings).
# Also enables save_prompt / private prompts later.
PROMPTS_CHAT_API_KEY=
